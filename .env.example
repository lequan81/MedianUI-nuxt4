# ── Gemini API Configuration ─────────────────────────────────────────────
# API Key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated list of models for load balancing / failover
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-2.0-flash-lite,gemini-1.5-flash

# Base URL for Gemini API
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Timeout in ms for Gemini API calls
GEMINI_TIMEOUT=3000

# ── Database Configuration ────────────────────────────────────────────────
DB_FILE_NAME=lequan81dev_app.sqlite

# ── Cloudflare Turnstile Captcha Configuration ────────────────────────────
# Testing Keys:
# Always Pass: SiteKey=1x00000000000000000000AA, SecretKey=1x0000000000000000000000000000000AA
# Always Challenge: SiteKey=3x00000000000000000000FF, SecretKey=3x0000000000000000000000000000000FF
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
NUXT_PUBLIC_TURNSTILE_SCRIPT_URL=https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit

# ── Admin Authentication Security ─────────────────────────────────────────
# Plaintext or Argon2id hash (e.g. bun -e "console.log(await Bun.password.hash('MyPass123', 'argon2id'))")
ADMIN_PASSWORD=admin123
# Secret salt for HMAC-SHA256 session token signature
ADMIN_HMAC_SECRET=median_secret_salt_123456_secure_key

